.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 10; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; z-index: 11;
         border-radius: 24rpx 24rpx 0 0; padding: 40rpx;
         padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.sheet-note { margin-top: 16rpx; text-align: center; font-size: 24rpx; color: #8a8a8a; }
.input { background: #f2f2f2; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.gender-row { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.gender-item { flex: 1; text-align: center; padding: 20rpx; border-radius: 12rpx; background: #f2f2f2; }
.gender-item.active { background: #1a1a1a; color: #fff; }
.agree-row { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 24rpx; font-size: 24rpx; }
.checkbox { width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid #bbb; text-align: center;
            line-height: 36rpx; font-size: 24rpx; flex-shrink: 0; }
.checkbox.checked { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
.agree-text { color: #5a5a5a; }
.link { color: #1a1a1a; text-decoration: underline; }
.btn-primary { background: #1a1a1a; color: #fff; border-radius: 999rpx; padding: 24rpx; text-align: center; }
.btn-primary.disabled { opacity: .4; }
.muted { color: #8a8a8a; }
