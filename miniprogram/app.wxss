/**
 * 设计令牌 —— 「有温度的出门感」
 * 暖纸底色、墨色文字、傍晚琥珀作强调;圆角与柔和阴影给卡片一点「邀请函」的手感。
 * 刻意不用粉红/心形/配对隐喻:这是约出门,不是约会(PRD §5)。
 */
page {
  --paper: #F7F2EA;        /* 暖纸底 */
  --card: #FFFDF9;         /* 卡片,比纯白暖一度 */
  --ink: #26221D;          /* 主文字 */
  --ink-2: #5C554B;        /* 次文字 */
  --mute: #9A9084;         /* 弱文字 */
  --line: #EDE6DB;         /* 分割线 */
  --amber: #D98A3C;        /* 傍晚琥珀:行动召唤 */
  --amber-soft: #FBEEDD;   /* 琥珀底 */
  --olive: #6F7D5C;        /* 成团/到位 */
  --olive-soft: #EEF1E6;
  --plum: #7A4F6B;         /* 酒馆局点缀 */
  --plum-soft: #F3E9F0;
  --sage: #6E8A86;         /* 展览/市集点缀 */
  --sage-soft: #E8EFEE;
  --radius: 24rpx;
  --shadow: 0 6rpx 24rpx rgba(60, 40, 10, 0.06);

  background: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

.card { background: var(--card); border-radius: var(--radius); padding: 32rpx; margin: 20rpx 24rpx; box-shadow: var(--shadow); }
.muted { color: var(--mute); font-size: 24rpx; }
.ink-2 { color: var(--ink-2); }

.btn-primary { background: var(--ink); color: #fff; border-radius: 999rpx; padding: 26rpx; text-align: center; font-weight: 600; letter-spacing: 1rpx; }
.btn-primary.disabled { opacity: .4; }
.btn-ghost { text-align: center; padding: 22rpx; color: var(--ink-2); }

/* 「还差 1 人」:整个产品的行动召唤,暖色小标签而非红字 */
.short-by { display: inline-block; color: var(--amber); background: var(--amber-soft); font-weight: 600; font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 999rpx; }
.short-by.done { color: var(--olive); background: var(--olive-soft); }

/* 座位点:已到位实心,空位虚心。只显示数量,不显示任何人 */
.seats { display: flex; gap: 10rpx; align-items: center; }
.seat { width: 18rpx; height: 18rpx; border-radius: 50%; border: 3rpx solid var(--amber); box-sizing: border-box; }
.seat.on { background: var(--amber); }
.seats.done .seat { border-color: var(--olive); }
.seats.done .seat.on { background: var(--olive); }

/* 场景色:每种局一个安静的底色,一眼能分 */
.tint-coffee { background: linear-gradient(160deg, #FBEEDD 0%, #FFFDF9 70%); }
.tint-art    { background: linear-gradient(160deg, #E8EFEE 0%, #FFFDF9 70%); }
.tint-bar    { background: linear-gradient(160deg, #F3E9F0 0%, #FFFDF9 70%); }
.scene-tag { display: inline-flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--ink-2); }
.scene-tag.coffee { color: #9A5F22; }
.scene-tag.art { color: #4F6B67; }
.scene-tag.bar { color: var(--plum); }

.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }
