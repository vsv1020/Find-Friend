.scene { font-size: 24rpx; color: #8a8a8a; }
.title { font-size: 40rpx; font-weight: 600; margin: 12rpx 0; }
.meta { margin-bottom: 16rpx; }
.desc { margin-top: 16rpx; }
.venue-name { font-weight: 600; margin-bottom: 8rpx; }
.footer { padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff;
         border-radius: 24rpx 24rpx 0 0; padding: 40rpx;
         padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.sheet-note { margin-top: 16rpx; text-align: center; }
.input { background: #f2f2f2; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.gender-row { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.gender-item { flex: 1; text-align: center; padding: 20rpx; border-radius: 12rpx;
               background: #f2f2f2; }
.gender-item.active { background: #1a1a1a; color: #fff; }
