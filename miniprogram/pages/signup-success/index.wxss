.done-card { text-align: center; padding: 56rpx 32rpx 44rpx; }
.done-mark { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--olive-soft); color: var(--olive);
             font-size: 48rpx; font-weight: 700; line-height: 96rpx; margin: 0 auto 20rpx; }
.done-title { font-size: 40rpx; font-weight: 700; margin-bottom: 10rpx; }
.rec-title { font-weight: 600; margin-bottom: 8rpx; }
.rec { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.rec:last-child { border-bottom: none; }
.rec-when { font-size: 24rpx; color: var(--ink-2); }
.rec-venue { font-weight: 600; }
